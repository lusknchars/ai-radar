# Local state stays separate from the historical database committed upstream.
RADAR_DB=data/local.db

# Kimi international platform. The setup wizard can switch this to China.
RADAR_LLM_PROVIDER=kimi
KIMI_API_KEY=
RADAR_KIMI_BASE_URL=https://api.moonshot.ai/v1

# Lightweight default for deep reports. Docling remains opt-in.
RADAR_PDF_EXTRACTOR=pypdf

# Replace these values with your GitHub fork. The wizard derives them for you.
RADAR_REPOSITORY=your-github-user/ai-radar
RADAR_SITE_BASE_PATH=/ai-radar
RADAR_SITE_URL=https://your-github-user.github.io/ai-radar

# Optional daily digest delivery.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Auto runs live collection when the selected model key is configured.
RADAR_COLLECTION_MODE=auto
EXA_API_KEY=
RADAR_EXA_MODE=daily
RADAR_EXA_RESULTS=10
RADAR_MAX_NEW_PER_SCOPE=20
RADAR_MAX_EQUATIONS_PER_RUN=5

# Set only after the signup service is deployed and verified.
RADAR_SUBSCRIBE_URL=

# Private signup service; these are server settings, never browser settings.
RADAR_SIGNUP_ORIGIN=
RADAR_EMAIL_FROM=
RESEND_API_KEY=
RESEND_SEGMENT_ID=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Absolute path OUTSIDE this public repository, on a persistent volume.
RADAR_SUBSCRIBER_DB=
