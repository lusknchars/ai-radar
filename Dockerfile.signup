FROM python:3.12-slim
WORKDIR /app
COPY pyproject.toml ./
COPY src/ src/
RUN pip install --no-cache-dir '.[newsletter]' && useradd --uid 10001 --create-home radar \
    && mkdir -p /var/lib/ai-radar && chown radar:radar /var/lib/ai-radar
USER radar
ENV RADAR_SUBSCRIBER_DB=/var/lib/ai-radar/signup.db
EXPOSE 8000
CMD ["uvicorn", "radar.subscriptions:create_app", "--factory", "--host", "0.0.0.0", "--port", "8000", "--no-access-log"]
